# Copy thành file .env (file .env nằm trong .gitignore — KHÔNG đẩy mật khẩu lên git)
CONNECTION_STRING=Server=YOUR_SERVER; Database=YOUR_DB; User Id=YOUR_USER; Password=YOUR_PASSWORD; Encrypt=True; TrustServerCertificate=True; MultipleActiveResultSets=True;
Jwt__SecretKey=PumsErp_DevSecretKey_ChangeMe_AtLeast32Chars!
Jwt__Issuer=pums-erp-api
Jwt__Audience=pums-erp-app

# Cloudinary — upload logo & file (điền từ dashboard Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pums-erp
